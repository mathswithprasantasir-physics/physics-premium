// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ইউজার মডেল =====
model User {
  id            Int           @id @default(autoincrement())
  email         String        @unique
  passwordHash  String        @map("password_hash")
  fullName      String?       @map("full_name")
  phone         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  lastLogin     DateTime?     @map("last_login")
  isAdmin       Boolean       @default(false) @map("is_admin")
  emailVerified Boolean       @default(false) @map("email_verified")

  accessTokens  AccessToken[]
  payments      Payment[]
  accessLogs    AccessLog[]

  @@map("users")
}

// ===== অ্যাক্সেস টোকেন =====
model AccessToken {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  token       String   @unique
  packageName String?  @map("package_name")
  amount      Decimal? @db.Decimal(10, 2)
  paymentId   String?  @map("payment_id")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @default(now()) @map("expires_at")
  isActive    Boolean  @default(true) @map("is_active")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLogs  AccessLog[]  // এই relation-এর জন্য AccessLog-এ বিপরীত relation দরকার

  @@map("access_tokens")
}

// ===== পেমেন্ট =====
model Payment {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  orderId     String?  @map("order_id")
  paymentId   String?  @map("payment_id")
  amount      Decimal  @db.Decimal(10, 2)
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ===== অ্যাক্সেস লগ =====
model AccessLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  token      String?
  accessedAt DateTime @default(now()) @map("accessed_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")

  // ✅ বিপরীত relation যোগ করুন
  accessToken AccessToken? @relation(fields: [token], references: [token])
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("access_logs")
}