{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "views/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/views/index.html" },
    { "src": "/login.html", "dest": "/views/login.html" },
    { "src": "/register.html", "dest": "/views/register.html" },
    { "src": "/dashboard/(.*)", "dest": "/views/dashboard/$1" },
    { "src": "/dashboard", "dest": "/views/dashboard/index.html" },
    { "src": "/blog/(.*)", "dest": "/views/blog-post.html" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}